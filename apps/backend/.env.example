# All optional. With no LLM key the assistant still answers, using an extractive
# (template) answer built from the retrieved symbols and call graph.

# LLM for the final synthesis step — the first one set wins (or force with LLM_PROVIDER).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=anthropic   # anthropic | groq | gemini | extractive

# Raises the GitHub API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# PORT=3100
# MAX_REPO_SIZE_MB=200
